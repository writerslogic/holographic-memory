+def test_transport_read_timeout_is_not_a_connect_timeout_or_the_connect_budget(server, reuse):
+    srv, url = server()
+    timeout = httpx.Timeout(2.0, read=0.05)
+    with httpx.Client(transport=KeepAliveTransport(), timeout=timeout) as client:
+        if reuse:
