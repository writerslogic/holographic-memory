+    fn archive_preflight_rejects_malformed_metadata_and_sparse_entries() {
+        let dir = tempfile::tempdir().unwrap();
+        for case in [
+            "duplicate",
+            "dangling",
+            "bad-size",
+            "overflow",
+            "truncated",
+            "sparse",
