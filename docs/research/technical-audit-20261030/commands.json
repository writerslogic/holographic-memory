  "provenance_compile": [
    "rustc",
    "+1.99.0",
    "--edition=2021",
    "docs/research/technical-audit-20261030/provenance_reproduction.rs",
    "-L",
    "dependency=target/review-gap-checks/build/debug/deps",
    "--extern",
