{
  "cwd": "/Volumes/A/holographic-memory",
  "focused_rust": {
    "argv": [
      "cargo",
      "+1.99.0",
      "test",
      "--offline",
      "--locked",
      "--all-features",
      "--lib",
      "--bin",
      "hms-server",
      "--bin",
      "hms-mcp",
      "--test",
      "memory_api",
      "--test",
      "native_memory_workflow",
      "--test",
      "committed_sidecars",
      "--test",
      "scitt_receipt_interop",
      "--test",
      "server_abuse",
      "--test",
      "server_ops",
      "--test",
      "memory_api_server"
