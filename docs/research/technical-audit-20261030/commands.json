    "env": {
      "CARGO_TARGET_DIR": "/Volumes/A/holographic-memory/target/review-gap-checks/build",
      "CARGO_BUILD_JOBS": "4",
      "CARGO_PROFILE_DEV_OPT_LEVEL": "1",
      "CARGO_PROFILE_TEST_OPT_LEVEL": "1",
      "CARGO_PROFILE_DEV_DEBUG": "0",
      "CARGO_PROFILE_TEST_DEBUG": "0"
    },
    "output": "focused-rust.log",
    "exit_code": 0
