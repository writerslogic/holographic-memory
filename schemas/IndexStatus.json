{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IndexStatus",
  "description": "Current index lifecycle state and the next recommended maintenance action.",
  "type": "object",
  "properties": {
    "ivfTrained": {
      "type": "boolean"
    },
    "ivfTrainingRecommended": {
      "type": "boolean"
    },
    "nsgTrained": {
      "type": "boolean"
    },
    "nsgTrainingRecommended": {
      "type": "boolean"
    },
    "recommendation": {
      "type": "string"
    },
    "vectorCount": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    }
  },
  "required": [
    "vectorCount",
    "nsgTrained",
    "ivfTrained",
    "nsgTrainingRecommended",
    "ivfTrainingRecommended",
    "recommendation"
  ]
}