+  git checkout "$HMS_REV"
+  maturin build --release --locked --out /tmp/hms-dist
+  pip install --no-cache-dir /tmp/hms-dist/*.whl
+  cd /
+  rm -rf /tmp/hms /tmp/hms-dist "$HOME/.cargo" "$HOME/.rustup"
+
+  python -c 'from holographic_memory import VectorIndex; print(VectorIndex())'
diff --git a/vibe/algorithms/hms/module.py b/vibe/algorithms/hms/module.py
