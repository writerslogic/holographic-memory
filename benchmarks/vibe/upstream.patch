+Bootstrap: localimage
+From: base.sif
+
+%post
+  WARM_REV=f73305b624305836211c8157975c4f1c37f10df9
+
+  curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --profile minimal --default-toolchain 1.96.0
+  export PATH="$HOME/.cargo/bin:$PATH"
+  pip install --no-cache-dir maturin==1.15.0
+
+  git clone https://github.com/writerslogic/warm.git /tmp/warm
+  cd /tmp/warm
+  git checkout "$WARM_REV"
+  RUSTFLAGS="-C target-cpu=native" maturin build --release --locked --out /tmp/warm-dist
+  pip install --no-cache-dir /tmp/warm-dist/*.whl
+  cd /
+  rm -rf /tmp/warm /tmp/warm-dist "$HOME/.cargo" "$HOME/.rustup"
+
+  python -c 'from writerslogic_warm import VectorIndex; print(VectorIndex())'
diff --git a/vibe/algorithms/warm/module.py b/vibe/algorithms/warm/module.py
new file mode 100644
index 0000000..d27a247
--- /dev/null
+++ b/vibe/algorithms/warm/module.py
@@ -0,0 +1,70 @@
+"""VIBE wrapper for WARM (writerslogic-warm), the quantized graph index.
+
+The index is a proximity graph whose traversal reads 4-bit (default) or 8-bit codes of the mean-centered rows;
+the `rerank` best candidates are re-scored with an 8-bit residual code. Cosine and normalized
+data are searched by angle, euclidean data by Euclidean distance, and ip data by inner product
+(reduced to Euclidean search by appending one coordinate to each row).
+"""
+import numpy as np
+from writerslogic_warm import VectorIndex
+
+from ..base.module import BaseANN
+
+METRICS = {"cosine": "angular", "normalized": "angular", "euclidean": "euclidean", "ip": "ip"}
+
+
+class WARM(BaseANN):
+    def __init__(self, metric, degree, build_ef, code_bits=4, query_aware=False):
+        if metric not in METRICS:
+            raise NotImplementedError(f"warm does not support the {metric} distance")
+        self.metric = metric
+        self.degree = degree
+        self.build_ef = build_ef
+        if code_bits not in (4, 8):
+            raise ValueError("code_bits must be 4 or 8")
+        self.code_bits = code_bits
+        self.query_aware = bool(query_aware)
+        self.ef = None
+        self.rerank = None
+        self.patience = 0
+        self.index = None
+
+    def fit(self, X):
+        if self.query_aware:
+            raise ValueError("query-aware WARM requires the separate learn split through fit_ood")
+        self._fit(X, None)
+
+    def fit_ood(self, X, X_learn, X_learn_neighbors):
+        self._fit(X, X_learn if self.query_aware else None)
+
+    def _fit(self, X, queries):
+        self.index = VectorIndex(METRICS[self.metric], degree=self.degree, build_ef=self.build_ef,
+                                 threads=1, code_bits=self.code_bits)
+        learning = None if queries is None else np.ascontiguousarray(queries, dtype=np.float32)
+        self.index.fit(np.ascontiguousarray(X, dtype=np.float32), training_queries=learning)
+
+    def set_query_arguments(self, ef, rerank=None, patience=0):
+        if rerank is None:
+            arguments = tuple(ef)
+            if len(arguments) == 2:
+                ef, rerank = arguments
+            elif len(arguments) == 3:
+                ef, rerank, patience = arguments
+            else:
+                raise ValueError("query arguments must contain ef, rerank and optional patience")
+        if patience == 0:
+            self.index.set_query_arguments(ef, rerank)
+        else:
+            self.index.set_query_arguments(ef, rerank, patience)
+        self.ef = ef
+        self.rerank = rerank
+        self.patience = patience
+
+    def query(self, v, n):
+        return self.index.query(v, n)
+
+    def __str__(self):
+        precision = "" if self.code_bits == 4 else f", code_bits={self.code_bits}"
+        training = ", query_aware=True" if self.query_aware else ""
+        early_stop = f", patience={self.patience}" if self.patience > 0 else ""
+        return f"WARM(metric={self.metric}, degree={self.degree}, build_ef={self.build_ef}, ef={self.ef}, rerank={self.rerank}{precision}{training}{early_stop})"
