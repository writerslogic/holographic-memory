  "timing": "each paired comparison is one /Volumes/A/.hms-target/timed.sh invocation, runs alternating, held <= 15 minutes",
  "graph_identity": "HMS_QGRAPH_BUILD_PROFILE=1 prints a hash of (adjacency, upper layers, entry); equal hashes mean a bit-identical graph"
 },
 "change": {
  "summary": "One 8-bit code per unit row (scale, i8 codes, residual-norm bound) gives a rigorous lower and upper bound on the computed f32 d2 of any two rows. Construction uses the bounds only to skip exact distances whose outcome they already decide: (1) construction search: a fresh neighbour whose lower bound is at or past the full pool's bound is dropped without loading its row; (2) robust prune: a kept vertex whose upper bound proves occlusion, or whose lower bound rules it out, is settled without an exact dot; (3) fill: ids whose lower bound exceeds the k-th smallest upper bound are not scored. Undecided cases are scored exactly, so every decision equals the exact one and the graph is bit-identical. Enabled at dim >= 128 only.",
  "build_memory": "Construction-time only: n * round_up(dim, 16) bytes of codes plus 8 bytes per row (nytimes 290k x 256: ~76 MB), freed after the build. index_bytes unchanged.",
  "binaries": {
   "pb_base": "integrate/qgraph-speed construction (commit 9647143 code) plus always-on phase timers (a few Instant::now per insert, negligible next to a ~100 ms insert); its nytimes held-out recall (0.90225 at ef 96, 0.9495 at ef 384, rerank 16) matches the committed qgraph_pareto_nytimes-256-angular_vertex_d64_res_untimed.json",
   "pb_f2": "baseline + 8-bit build codes screening exact distances in the construction search, the robust prune and the fill, at every dimension",
   "pb_f3": "pb_f2 with the construction-search screen disabled below 128 dimensions (prune and fill screens kept)",
   "pb_f4": "committed version: all build-code screens only at dim >= 128 (glove-100 runs the baseline path); fill drops existing neighbours after dedup instead of before"
  }
 },
