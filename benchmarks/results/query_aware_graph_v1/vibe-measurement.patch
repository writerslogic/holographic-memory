+# Copyright 2024-2026 WritersLogic Contributors
+# SPDX-License-Identifier: Apache-2.0
+"""VIBE worker adapter for paired HMS encodings and permitted-query CPU indexes."""
+
+import importlib.machinery
+import importlib.util
+import hashlib
+import operator
+import os
+from pathlib import Path
+import resource
+import sys
+import threading
+import time
+import types
+
+import numpy as np
+
+from ..base.module import BaseANN
+
+
+METRICS = {"cosine": "angular", "normalized": "angular", "euclidean": "euclidean", "ip": "ip"}
+ARM_NAMES = {0: "baseline4", 1: "candidate8", 2: "roargraph48", 3: "roargraph96", 4: "mlann_rf10_depth14"}
+MLANN_THRESHOLDS = {1: 5e-4, 2: 5e-5, 3: 5e-6}
+
+
+def _extension_path(variable):
+    value = os.environ.get(variable)
+    if not value:
+        raise ValueError(f"{variable} must name the task-local extension")
+    path = Path(value).expanduser().resolve(strict=True)
+    if not path.is_file() or not any(str(path).endswith(s) for s in importlib.machinery.EXTENSION_SUFFIXES):
+        raise ValueError(f"{variable} must name a Python extension file")
+    return path
+
+
+def _load_extension(path, package_name):
+    # The final component selects PyInit_holographic_memory; distinct parent packages keep
+    # both shared libraries registered without replacing the installed package.
+    name = f"{package_name}.holographic_memory"
+    if name in sys.modules:
+        module = sys.modules[name]
+        if Path(module.__file__).resolve() != path:
+            raise ValueError(f"{package_name} already holds a different extension")
+        return module
+    package = types.ModuleType(package_name)
+    package.__path__ = []
+    sys.modules[package_name] = package
+    try:
+        spec = importlib.util.spec_from_file_location(name, path)
+        if spec is None or spec.loader is None:
+            raise ImportError(f"cannot load extension {path}")
+        module = importlib.util.module_from_spec(spec)
+        sys.modules[name] = module
+        spec.loader.exec_module(module)
+        setattr(package, "holographic_memory", module)
+        return module
+    except BaseException:
+        sys.modules.pop(name, None)
+        sys.modules.pop(package_name, None)
+        raise
+
+
+def _matrix(values, name):
+    rows = np.asarray(values, dtype=np.float32, order="C")
+    if rows.ndim != 2 or not all(rows.shape) or not np.isfinite(rows).all():
+        raise ValueError(f"{name} must be a finite nonempty matrix")
+    return rows
+
+
+def _aligned_f32_matrix(values, name):
+    rows = _matrix(values, name)
+    # MLANN de8f9d6 cpp/distance.h uses _mm256_load_ps in its FMA/AVX2 dot product;
+    # every row and query must start on a 32-byte boundary, beyond NumPy ALIGNED.
+    if rows.shape[1] % 8:
+        raise ValueError("MLANN requires dimensions divisible by eight for 32-byte row strides")
+    owner = np.empty(rows.size + 7, dtype=np.float32)
+    offset = (-owner.ctypes.data % 32) // owner.itemsize
+    aligned = owner[offset:offset + rows.size].reshape(rows.shape)
+    aligned[:] = rows
+    if aligned.ctypes.data % 32 or aligned.strides[0] % 32 or not aligned.flags.c_contiguous:
+        raise RuntimeError("MLANN matrix alignment invariant failed")
+    return aligned, owner
+
+
+def _training_query_file(dim, max_rows):
+    value = os.environ.get("HMS_QAG_TRAINING_QUERIES")
+    expected = os.environ.get("HMS_QAG_TRAINING_QUERIES_SHA256")
+    if value is None:
+        if expected is not None:
+            raise ValueError("a training-query SHA256 requires HMS_QAG_TRAINING_QUERIES")
+        return None, None, None
+    if not value:
+        raise ValueError("HMS_QAG_TRAINING_QUERIES must name a native float32 file")
+    path = Path(value).expanduser().resolve(strict=True)
+    size = path.stat().st_size
+    row_bytes = dim * np.dtype("<f4").itemsize
+    if not path.is_file() or size == 0 or size % row_bytes or size > max_rows * row_bytes:
+        raise ValueError("training-query file must contain complete nonempty rows within the construction pool size")
+    values = np.fromfile(path, dtype="<f4", count=size // 4)
+    if values.nbytes != size or path.stat().st_size != size:
+        raise ValueError("training-query file changed size while reading")
+    rows = _matrix(values.reshape(-1, dim), "candidate training queries")
+    digest = hashlib.sha256(memoryview(values).cast("B")).hexdigest()
+    if expected is not None:
+        if len(expected) != 64 or any(c not in "0123456789abcdefABCDEF" for c in expected):
+            raise ValueError("training-query SHA256 must contain 64 hexadecimal digits")
+        if digest != expected.lower():
+            raise ValueError("training-query file does not match the expected SHA256")
+    return rows, str(path), digest
+
+
+class QAGPair(BaseANN):
+    def __init__(self, metric, degree, build_ef, candidate_code_bits=8):
+        if metric not in METRICS:
+            raise NotImplementedError(f"QAGPair does not support the {metric} distance")
+        candidate_code_bits = operator.index(candidate_code_bits)
+        if candidate_code_bits not in (4, 8):
+            raise ValueError("candidate_code_bits must be 4 or 8")
+        self._candidate_code_bits = candidate_code_bits
+        baseline = _extension_path("HMS_QAG_BASELINE_SO")
+        candidate = _extension_path("HMS_QAG_CANDIDATE_SO")
+        if os.path.samefile(baseline, candidate):
+            raise ValueError("baseline and candidate must be distinct extension files")
+        self._modules = (
+            _load_extension(baseline, "_hms_qag_baseline"),
+            _load_extension(candidate, "_hms_qag_candidate"),
+        )
+        self.metric = metric
+        self.degree = degree
+        self.build_ef = build_ef
+        self._paths = (str(baseline), str(candidate))
+        self._indexes = {}
+        self._build_seconds = {}
+        self._query = None
+        self.arm = None
+        self.ef = None
+        self.rerank = None
+        self.repetition = None
+        self.patience = 0
+        self._candidate_patience = 0
+        self._validation_count = 0
+        self._construction_count = 0
+        self._training_count = 0
+        self._training_path = None
+        self._training_sha256 = None
+        self._mlann_owners = ()
+        self._mlann_query = None
+        self._mlann_threshold = None
+        self._mlann_distance = None
+        self._mlann_base_count = 0
+        self._mlann_query_lock = threading.Lock()
+
+    def fit(self, X):
+        rows = _matrix(X, "base vectors")
+        self._fit_hms(rows)
+
+    def _fit_hms(self, rows, training_queries=None):
+        self._indexes.clear()
+        self._candidate_patience = 0
+        self._build_seconds.clear()
+        self._query = None
+        self._validation_count = 0
+        self._construction_count = 0
+        self._training_count = 0 if training_queries is None else len(training_queries)
+        self._training_path = None
+        self._training_sha256 = None
+        self._mlann_owners = ()
+        self._mlann_query = None
+        self._mlann_threshold = None
+        self._mlann_distance = None
+        self._mlann_base_count = 0
+        for arm, module in enumerate(self._modules):
+            options = {"degree": self.degree, "build_ef": self.build_ef, "threads": 1}
+            if arm == 1:
+                options["code_bits"] = self._candidate_code_bits
+            started = time.perf_counter()
+            index = module.VectorIndex(METRICS[self.metric], **options)
+            if arm == 1 and training_queries is not None:
+                index.fit(rows, training_queries=training_queries)
+            else:
+                index.fit(rows)
+            self._build_seconds[arm] = time.perf_counter() - started
+            self._indexes[arm] = index
+
+    def fit_ood(self, X, X_learn, X_learn_neighbors):
+        rows = _matrix(X, "base vectors")
+        learn = _matrix(X_learn, "learn queries")
+        neighbors = np.asarray(X_learn_neighbors)
+        if learn.shape[1] != rows.shape[1]:
+            raise ValueError("learn queries must match base dimension")
+        if neighbors.ndim != 2 or neighbors.shape[0] != len(learn) or neighbors.shape[1] == 0:
+            raise ValueError("learn neighbors must have one nonempty row per learn query")
+        if neighbors.dtype.kind not in "iu" or np.any(neighbors < 0) or np.any(neighbors >= len(rows)):
+            raise ValueError("learn neighbors must contain integer base IDs in range")
+        value = os.environ.get("HMS_QAG_VALIDATION_IDS")
+        if not value:
+            raise ValueError("HMS_QAG_VALIDATION_IDS must name the reserved learn-row IDs")
+        path = Path(value).expanduser().resolve(strict=True)
+        size = path.stat().st_size
+        if not path.is_file() or size % 4 or size > len(learn) * 4:
+            raise ValueError("reserved validation IDs must be complete uint32 rows")
+        reserved = np.fromfile(path, dtype="<u4")
+        if len(np.unique(reserved)) != len(reserved) or np.any(reserved >= len(learn)):
+            raise ValueError("reserved validation IDs must be unique learn IDs in range")
+        keep = np.ones(len(learn), dtype=bool)
+        keep[reserved] = False
+        if not keep.any():
+            raise ValueError("reserved validation IDs leave no construction queries")
+        construction_queries = np.ascontiguousarray(learn[keep])
+        construction_neighbors = np.ascontiguousarray(neighbors[keep], dtype=np.uint32)
+        if len(construction_queries) < 1 << 14:
+            raise ValueError("MLANN depth 14 requires at least 16384 construction queries")
+        if rows.shape[1] % 8:
+            raise ValueError("MLANN requires dimensions divisible by eight for 32-byte row strides")
+        training_queries, training_path, training_sha256 = _training_query_file(
+            rows.shape[1], len(construction_queries)
+        )
+        self._fit_hms(rows, training_queries)
+        self._validation_count = len(reserved)
+        self._construction_count = len(construction_queries)
+        self._training_path = training_path
+        self._training_sha256 = training_sha256
+        from ..roargraph.module import RoarGraph
+
+        for arm, projected_degree in ((2, 48), (3, 96)):
+            started = time.perf_counter()
+            index = RoarGraph(self.metric, 100, projected_degree, 500)
+            # The upstream cosine wrapper normalizes its base argument in place.
+            index.fit_ood(rows.copy(), construction_queries, construction_neighbors)
+            self._build_seconds[arm] = time.perf_counter() - started
+            self._indexes[arm] = index
+
+        import mlann
+
+        started = time.perf_counter()
+        mlann_base, base_owner = _aligned_f32_matrix(rows, "MLANN base vectors")
+        mlann_learn, learn_owner = _aligned_f32_matrix(
+            construction_queries, "MLANN construction queries"
+        )
+        mlann_query, query_owner = _aligned_f32_matrix(
+            np.zeros((1, rows.shape[1]), dtype=np.float32), "MLANN query buffer"
+        )
+        if self.metric == "cosine":
+            for values in (mlann_base, mlann_learn):
+                norms = np.linalg.norm(values.astype(np.float64), axis=1, keepdims=True)
+                if np.any(norms == 0):
+                    raise ValueError("MLANN cosine vectors must have nonzero norm")
+                values /= norms
+        self._mlann_owners = (base_owner, learn_owner, query_owner)
+        self._mlann_query = mlann_query[0]
+        self._mlann_base_count = len(rows)
+        self._mlann_distance = mlann.IP if self.metric in ("cosine", "normalized", "ip") else mlann.L2
+        index = mlann.MLANNIndex(mlann_base, "RF")
+        index.build(mlann_learn, construction_neighbors, 10, 14)
+        self._build_seconds[4] = time.perf_counter() - started
+        self._indexes[4] = index
+
+    def set_query_arguments(self, arm, ef=None, rerank=None, repetition=None, patience=0):
+        if ef is None and rerank is None and repetition is None:
+            if not isinstance(arm, (list, tuple)) or len(arm) not in (4, 5):
+                raise ValueError("paired query arguments require four or five integers")
+            values = tuple(arm)
+            arm, ef, rerank, repetition = values[:4]
+            patience = values[4] if len(values) == 5 else 0
+        arm, ef, rerank, repetition, patience = map(operator.index, (arm, ef, rerank, repetition, patience))
+        if arm not in ARM_NAMES or ef <= 0 or rerank < 0 or repetition < 0 or patience < 0:
+            raise ValueError("invalid paired arm, query effort or repetition")
+        if patience and arm != 1:
+            raise ValueError("early stopping is only measured on the candidate arm")
+        if arm not in self._indexes:
+            raise ValueError("selected arm was not built; learned indexes require fit_ood")
+        index = self._indexes[arm]
+        if arm < 2:
+            if arm == 1 and (patience or self._candidate_patience):
+                index.set_query_arguments(ef, rerank, patience=patience)
+                self._candidate_patience = patience
+            else:
+                index.set_query_arguments(ef, rerank)
+        elif arm == 4:
+            if ef not in MLANN_THRESHOLDS:
+                raise ValueError("MLANN effort must be 1, 2 or 3")
+            self._mlann_threshold = MLANN_THRESHOLDS[ef]
+        else:
+            index.set_query_arguments(ef)
+        self.arm, self.ef, self.rerank, self.repetition = arm, ef, rerank, repetition
+        self.patience = patience
+        self._query = self._query_mlann if arm == 4 else index.query
+
+    def _query_mlann(self, v, n):
+        count = operator.index(n)
+        query = np.asarray(v, dtype=np.float32)
+        if query.ndim != 1 or query.shape != self._mlann_query.shape or not np.isfinite(query).all():
+            raise ValueError("MLANN query must be a finite vector matching the base dimension")
+        if not 1 <= count <= self._mlann_base_count:
+            raise ValueError("MLANN result count must be within the base row count")
+        with self._mlann_query_lock:
+            np.copyto(self._mlann_query, query)
+            if self.metric == "cosine":
+                norm = np.linalg.norm(self._mlann_query.astype(np.float64))
+                if norm == 0:
+                    raise ValueError("MLANN cosine query must have nonzero norm")
+                self._mlann_query /= norm
+            ids = np.asarray(self._indexes[4].ann(
+                self._mlann_query, count, self._mlann_threshold,
+                self._mlann_distance, return_distances=False,
+            ))
+        if ids.ndim != 1 or len(ids) > count or ids.dtype.kind not in "iu":
+            raise RuntimeError("MLANN returned invalid result IDs")
+        if np.any(ids < -1) or np.any(ids >= self._mlann_base_count):
+            raise RuntimeError("MLANN returned a base ID out of range")
+        ids = ids[ids >= 0]
+        if len(np.unique(ids)) != len(ids):
+            raise RuntimeError("MLANN returned duplicate base IDs")
+        return ids
+
+    def query(self, v, n):
+        return self._query(v, n)
+
+    def get_additional(self):
+        attrs = {
+            "qag_arm": -1 if self.arm is None else self.arm,
+            "qag_repetition": -1 if self.repetition is None else self.repetition,
+            "qag_patience": self.patience,
+            "qag_baseline_so": self._paths[0],
+            "qag_candidate_so": self._paths[1],
+            "qag_candidate_code_bits": self._candidate_code_bits,
+            "qag_reserved_validation_queries": self._validation_count,
+            "qag_construction_queries": self._construction_count,
+            "qag_candidate_training_queries": self._training_count,
+            "qag_resource_scope": "all built arms co-resident; VIBE index_size is aggregate USS delta, not per-arm peak RSS or serialized bytes",
+            "qag_thread_environment": ",".join(f"{key}={os.environ.get(key, '')}" for key in (
+                "OMP_NUM_THREADS", "MKL_NUM_THREADS", "OPENBLAS_NUM_THREADS", "NUMEXPR_NUM_THREADS", "RAYON_NUM_THREADS")),
+        }
+        if hasattr(os, "sched_getaffinity"):
+            attrs["qag_cpu_affinity"] = sorted(os.sched_getaffinity(0))
+        if self._training_path is not None:
+            attrs["qag_candidate_training_query_file"] = self._training_path
+            attrs["qag_candidate_training_query_sha256"] = self._training_sha256
+        for arm, index in self._indexes.items():
+            name = f"candidate{self._candidate_code_bits}" if arm == 1 else ARM_NAMES[arm]
+            attrs[f"qag_{name}_build_seconds"] = self._build_seconds[arm]
+            if hasattr(index, "index_bytes"):
+                attrs[f"qag_{name}_index_bytes"] = int(index.index_bytes)
+        if 4 in self._indexes:
+            attrs["qag_mlann_seed"] = "uncontrolled std::random_device; one forest reused across repetitions"
+            attrs["qag_mlann_query_copy"] = "32-byte aligned float32 buffer copy included in query timing"
+            attrs["qag_mlann_construction"] = "RF, n_trees=10, depth=14; same reserved-query exclusion as RoarGraph"
+            if self.arm == 4:
+                attrs["qag_mlann_voting_threshold"] = self._mlann_threshold
+        if sys.platform == "linux":
+            attrs["qag_process_peak_rss_kib"] = resource.getrusage(resource.RUSAGE_SELF).ru_maxrss
+        return attrs
+
+    def __str__(self):
+        return (f"QAGPair(metric={self.metric}, degree={self.degree}, build_ef={self.build_ef}, "
+                f"arm={self.arm}, ef={self.ef}, rerank={self.rerank}, repetition={self.repetition})")
