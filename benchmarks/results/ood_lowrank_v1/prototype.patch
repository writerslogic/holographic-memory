index 00000000..54681c30
--- /dev/null
+++ b/src/python/lowrank_ivf.rs
@@ -0,0 +1,136 @@
+// Copyright 2024-2026 WritersLogic Contributors
+// SPDX-License-Identifier: Apache-2.0
+//! Experimental `LowRankIvf`: the cluster index with low-rank score regression, for
+//! measurement against `VectorIndex` on out-of-distribution queries. Not persisted.
+
+use numpy::{
+    AllowTypeChange, IntoPyArray, PyArray1, PyArrayLike1, PyArrayLike2, PyUntypedArrayMethods,
+};
+use pyo3::exceptions::{PyRuntimeError, PyValueError};
+use pyo3::prelude::*;
+
+use crate::core::qgraph::lowrank::{
+    LowRankIvf, LowRankMetric, LowRankParams, LowRankScratch, LowRankSearchParams,
+};
+
+#[pyclass(name = "LowRankIvf", unsendable)]
+pub(super) struct PyLowRankIvf {
+    metric: LowRankMetric,
+    params: LowRankParams,
+    search: LowRankSearchParams,
+    index: Option<LowRankIvf>,
+    scratch: LowRankScratch,
+    out: Vec<u32>,
+}
+
+fn matrix(x: &PyArrayLike2<'_, f32, AllowTypeChange>) -> Vec<f32> {
+    match x.as_slice() {
+        Ok(s) if x.is_c_contiguous() => s.to_vec(),
+        _ => x.as_array().iter().copied().collect(),
+    }
+}
+
+#[pymethods]
+impl PyLowRankIvf {
+    /// `metric` is "ip" or "angular"; `train_top` is how many best-ranked clusters each
+    /// training query trains.
+    #[new]
+    #[pyo3(signature = (metric, n_clusters, rank, train_top=32, seed=24301))]
+    fn new(
+        metric: &str,
+        n_clusters: usize,
+        rank: usize,
+        train_top: usize,
+        seed: u64,
+    ) -> PyResult<Self> {
+        let metric = match metric {
+            "ip" => LowRankMetric::InnerProduct,
+            "angular" => LowRankMetric::Angular,
+            other => return Err(PyValueError::new_err(format!("unsupported metric {other}"))),
+        };
+        Ok(Self {
+            metric,
+            params: LowRankParams {
+                clusters: n_clusters,
+                rank,
+                train_top,
+                seed,
+            },
+            search: LowRankSearchParams {
+                nprobe: 16,
+                rerank: 200,
+            },
+            index: None,
+            scratch: LowRankScratch::default(),
+            out: Vec::new(),
+        })
+    }
+
+    #[pyo3(signature = (x, training_queries=None))]
+    fn fit(
+        &mut self,
+        py: Python<'_>,
+        x: PyArrayLike2<'_, f32, AllowTypeChange>,
+        training_queries: Option<PyArrayLike2<'_, f32, AllowTypeChange>>,
+    ) -> PyResult<()> {
+        let dim = x.shape()[1];
+        let rows = matrix(&x);
+        let training = match training_queries {
+            Some(q) if q.shape()[1] != dim => {
+                return Err(PyValueError::new_err(
+                    "training queries have the wrong dimension",
+                ))
+            }
+            Some(q) => matrix(&q),
+            None => Vec::new(),
+        };
+        let (metric, params) = (self.metric, self.params);
+        let index = py
+            .detach(|| LowRankIvf::build(&rows, dim, &training, metric, &params))
+            .map_err(|e| PyValueError::new_err(e.to_string()))?;
+        self.index = Some(index);
+        Ok(())
+    }
+
+    fn set_query_arguments(&mut self, nprobe: usize, rerank: usize) -> PyResult<()> {
+        if nprobe == 0 {
+            return Err(PyValueError::new_err("nprobe must be positive"));
+        }
+        self.search = LowRankSearchParams { nprobe, rerank };
+        Ok(())
+    }
+
+    fn query<'py>(
+        &mut self,
+        py: Python<'py>,
+        v: PyArrayLike1<'py, f32, AllowTypeChange>,
+        k: usize,
+    ) -> PyResult<Bound<'py, PyArray1<i64>>> {
+        let Self {
+            index,
+            scratch,
+            out,
+            search,
+            ..
+        } = self;
+        let index = index
+            .as_ref()
+            .ok_or_else(|| PyRuntimeError::new_err("the index is not fitted; call fit first"))?;
+        let q: Vec<f32>;
+        let slice = match v.as_slice() {
+            Ok(s) => s,
+            Err(_) => {
+                q = v.as_array().iter().copied().collect();
+                &q
+            }
+        };
+        index
+            .search(slice, k, *search, scratch, out)
+            .map_err(|e| PyValueError::new_err(e.to_string()))?;
+        Ok(out
+            .iter()
+            .map(|&i| i64::from(i))
+            .collect::<Vec<_>>()
+            .into_pyarray(py))
+    }
+}
