+    /// `k`-nearest-neighbour lists by NN-descent (Dong, Moses and Li, WWW 2011): every vertex
+    /// starts with `k` seeded random neighbours and each round scores, for every vertex, the
+    /// neighbours of its neighbours and of its reverse neighbours (through entries new since
+    /// the last round only), keeping the `k` nearest. A round reads a frozen graph and writes
+    /// each vertex's own list, so the result depends only on the data, `k` and `seed`. Stops
+    /// after `rounds` or once a round changes fewer than one entry per thousand.
+    fn nn_descent(&self, k: usize, rounds: usize, seed: u64) -> Vec<Vec<(f32, u32)>> {
+        const NEW: u32 = 1 << 31;
+        let n = self.data.len() / self.dim;
+        let k = k.min(n - 1).max(1);
+        let mut lists: Vec<Vec<(f32, u32)>> = (0..n as u32)
+            .into_par_iter()
+            .map(|v| {
+                let mut rng = SplitMix(seed ^ (u64::from(v).wrapping_mul(0x9E37_79B9_7F4A_7C15)));
