+                    let u = (rng.next_u64() % n as u64) as u32;
+                    if u != v && !ids.contains(&u) {
+                        ids.push(u);
+                    }
+                }
+                let mut d = Vec::new();
+                self.d2_stream(self.row(v), &ids, &mut d);
+                let mut l: Vec<(f32, u32)> =
+                    d.into_iter().zip(ids).map(|(d, u)| (d, u | NEW)).collect();
+                l.sort_by(|a, b| a.0.total_cmp(&b.0).then((a.1 & !NEW).cmp(&(b.1 & !NEW))));
+                l
+            })
+            .collect();
+        for _ in 0..rounds {
+            // Reverse neighbours as (target, source | NEW when the edge is new), sorted.
+            let mut rev: Vec<(u32, u32)> = lists
+                .iter()
+                .enumerate()
+                .flat_map(|(v, l)| {
+                    l.iter()
+                        .map(move |&(_, u)| (u & !NEW, v as u32 | (u & NEW)))
+                })
+                .collect();
+            rev.par_sort_unstable();
+            let mut rev_off = vec![0u32; n + 1];
+            for &(t, _) in &rev {
+                rev_off[t as usize + 1] += 1;
+            }
+            for i in 0..n {
+                rev_off[i + 1] += rev_off[i];
