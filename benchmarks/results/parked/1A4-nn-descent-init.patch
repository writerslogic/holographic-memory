+    fn locality_order(&self, shuffled: &[u32], clusters: usize, seed: u64) -> Vec<u32> {
+        let n = shuffled.len();
+        let k = clusters.min(n).max(1);
+        let dim = self.dim;
+        let mut centroids: Vec<f32> = shuffled[..k]
+            .iter()
+            .flat_map(|&v| self.row(v).iter().copied())
+            .collect();
+        let mut assign = vec![0u32; n];
+        for _ in 0..3 {
+            let c = &centroids;
+            assign = (0..n as u32)
+                .into_par_iter()
+                .map(|v| {
+                    let x = self.row(v);
+                    let mut best = (f32::NEG_INFINITY, 0u32);
+                    for (j, cj) in c.chunks_exact(dim).enumerate() {
+                        let s = dot(x, cj);
+                        if s > best.0 {
+                            best = (s, j as u32);
+                        }
+                    }
+                    best.1
