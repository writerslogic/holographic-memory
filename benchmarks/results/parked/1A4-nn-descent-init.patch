+            for (j, cj) in centroids.chunks_exact_mut(dim).enumerate() {
+                if counts[j] > 0 {
+                    let s = &sums[j * dim..(j + 1) * dim];
+                    let norm = s.iter().map(|x| x * x).sum::<f64>().sqrt().max(1e-12);
+                    cj.iter_mut()
+                        .zip(s)
+                        .for_each(|(c, &x)| *c = (x / norm) as f32);
+                }
+            }
+        }
+        let mut rng = SplitMix(seed ^ 0x10CA_1170);
