+            .map(|_| (rng.next_u64() >> 40) as f32 / (1u64 << 24) as f32 - 0.5)
+            .collect();
+        let mut keyed: Vec<(u32, f32, u32, u32)> = shuffled
+            .iter()
+            .enumerate()
+            .map(|(pos, &v)| (assign[v as usize], dot(self.row(v), &dir), pos as u32, v))
+            .collect();
+        keyed.par_sort_unstable_by(|a, b| {
+            a.0.cmp(&b.0).then(a.1.total_cmp(&b.1)).then(a.2.cmp(&b.2))
+        });
+        keyed.into_iter().map(|e| e.3).collect()
+    }
