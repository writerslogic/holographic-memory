+                                let w = w & !NEW;
+                                if w as usize != v {
+                                    cands.push(w);
+                                }
+                            }
+                        }
+                    };
+                    for &(_, u) in list {
+                        push_from(u & !NEW, u & NEW != 0, &mut cands);
+                    }
+                    for &(_, s) in rev[rev_off[v] as usize..rev_off[v + 1] as usize]
+                        .iter()
+                        .take(k)
+                    {
+                        let s_new = s & NEW != 0;
+                        let s = s & !NEW;
+                        if s_new {
+                            cands.push(s);
+                        }
+                        push_from(s, s_new, &mut cands);
+                    }
+                    cands.sort_unstable();
+                    cands.dedup();
+                    let mut have: Vec<u32> = list.iter().map(|e| e.1 & !NEW).collect();
+                    have.sort_unstable();
+                    cands.retain(|c| have.binary_search(c).is_err());
+                    if cands.is_empty() {
+                        return Vec::new();
+                    }
+                    let mut d = Vec::new();
+                    self.d2_stream(self.row(v as u32), &cands, &mut d);
+                    let bound = list[list.len() - 1].0;
+                    let mut out: Vec<(f32, u32)> = d
+                        .into_iter()
+                        .zip(cands)
+                        .filter(|&(d, _)| d < bound)
