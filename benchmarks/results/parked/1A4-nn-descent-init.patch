+                .collect();
+            let changed: usize = lists
+                .par_iter_mut()
+                .zip(updates)
+                .map(|(list, up)| {
+                    for e in list.iter_mut() {
+                        e.1 &= !NEW;
+                    }
+                    let mut c = 0;
+                    for (d, u) in up {
