+/// Advances `cursor` to the first posting at or after `slot`, galloping from its current
+/// position, and returns that posting's frequency when it is exactly `slot`.
+fn gallop(postings: &[(u32, u32)], cursor: &mut usize, slot: u32) -> Option<u32> {
+    let mut low = *cursor;
+    if postings[low].0 < slot {
+        let mut step = 1;
+        let mut high = low + 1;
+        while high < postings.len() && postings[high].0 < slot {
+            low = high;
+            step *= 2;
+            high = low + step;
+        }
+        let high = high.min(postings.len());
+        low += postings[low..high].partition_point(|p| p.0 < slot);
+    }
+    *cursor = low;
+    let (found, tf) = postings[low];
+    (found == slot).then_some(tf)
+}
