+/// Exact top-`limit` lexical ranking under the store lock. A document-at-a-time pass merges
+/// the posting lists whose score bounds can still reach the current `limit`-th score (the
+/// essential lists) and probes the rest by galloping only for candidates that survive the
+/// bound, so common terms cost a sequential decode and no per-chunk work. Contributions are
+/// summed in the same (form, word) order as [`execute_chunks`], which makes the captured
+/// scores bit-identical to scoring every candidate.
+#[cfg(test)]
+pub(super) static RANKED: std::sync::atomic::AtomicBool = std::sync::atomic::AtomicBool::new(true);
+
+#[cfg(test)]
+pub(super) static RANKED_NS: [std::sync::atomic::AtomicU64; 3] = [
+    std::sync::atomic::AtomicU64::new(0),
+    std::sync::atomic::AtomicU64::new(0),
+    std::sync::atomic::AtomicU64::new(0),
+];
+
+fn capture_ranked_lexical(store: &DocumentStore, prepared: PreparedSearch) -> CapturedQuery {
+    #[cfg(test)]
+    let t0 = std::time::Instant::now();
+    struct TermList {
+        /// Position in the (form, word) summation order.
+        order: usize,
+        idf: f64,
+        bound: f64,
+        postings: Vec<(u32, u32)>,
+        cursor: usize,
+    }
+    let n = store.chunk_count as f64;
+    let average = (store.word_count as f64 / n).max(1.0);
+    let mut dfs: [BTreeMap<String, usize>; 2] = Default::default();
+    let mut lists = Vec::new();
+    let mut order = 0;
+    for (form, terms) in prepared.query_terms.iter().enumerate() {
+        for word in terms.keys() {
+            let source = store.postings[form].get(word);
+            let df = source.map_or(0, PostingList::len);
+            dfs[form].insert(word.clone(), df);
+            if let Some(source) = source {
+                let idf = (1.0 + (n - df as f64 + 0.5) / (df as f64 + 0.5)).ln();
+                let mut postings = Vec::with_capacity(df + 1);
+                let mut max_tf = 0u32;
+                source.for_each(|slot, tf| {
+                    max_tf = max_tf.max(tf);
+                    postings.push((slot as u32, tf));
+                });
+                // The sentinel keeps every cursor in bounds without a check per step.
+                postings.push((u32::MAX, 0));
+                // Every chunk norm is at least 1.2 * 0.25 and the term weight grows with the
+                // frequency, so this bounds the term's contribution to any chunk.
+                let tf = f64::from(max_tf);
+                let bound = (idf * tf * 2.2 / (tf + 0.3)).max(0.0) * (1.0 + 1e-9);
+                lists.push(TermList {
+                    order,
+                    idf,
+                    bound,
+                    postings,
+                    cursor: 0,
+                });
+            }
+            order += 1;
+        }
+    }
+    #[cfg(test)]
+    let t1 = std::time::Instant::now();
+    lists.sort_by(|a, b| a.bound.total_cmp(&b.bound));
+    let prefix: Vec<f64> = lists
+        .iter()
+        .scan(0.0, |total, list| {
+            *total += list.bound;
+            Some(*total)
+        })
+        .collect();
+    let compare = |a: &(f64, u32), b: &(f64, u32)| {
+        b.0.total_cmp(&a.0).then_with(|| {
+            let (da, ia) = store.slot_owner(a.1 as usize);
+            let (db, ib) = store.slot_owner(b.1 as usize);
+            (da.id.as_str(), ia).cmp(&(db.id.as_str(), ib))
+        })
+    };
+    let limit = prepared.limit;
+    let mut kept: Vec<(f64, u32)> = Vec::with_capacity(2 * limit + 1);
+    // Candidates scoring below this cannot enter the top `limit`; lists[..essential] cannot
+    // lift a candidate over it on their own.
+    let mut threshold = 0.0f64;
+    let mut essential = 0;
+    // Per query word in summation order: its idf and the current candidate's term frequency.
+    let mut idf_by_order = vec![0.0f64; order];
+    for list in &lists {
+        idf_by_order[list.order] = list.idf;
+    }
+    let mut hits = vec![0u32; order];
+    loop {
+        let mut slot = u32::MAX;
+        for list in &lists[essential..] {
+            slot = slot.min(list.postings[list.cursor].0);
+        }
+        if slot == u32::MAX {
+            break;
+        }
+        let norm = 1.2 * (0.25 + 0.75 * f64::from(store.slot_word_count(slot as usize)) / average);
+        let mut partial = 0.0;
+        for list in &mut lists[essential..] {
+            let (next, tf) = list.postings[list.cursor];
+            let hit = next == slot;
+            hits[list.order] = if hit { tf } else { 0 };
+            if hit {
+                let tf = f64::from(tf);
+                partial += list.idf * tf * 2.2 / (tf + norm);
+                list.cursor += 1;
+            }
+        }
+        let rest = if essential == 0 {
+            0.0
+        } else {
+            prefix[essential - 1]
+        };
+        if (partial + rest) * (1.0 + 1e-9) < threshold {
+            continue;
+        }
+        for list in &mut lists[..essential] {
+            hits[list.order] = gallop(&list.postings, &mut list.cursor, slot).unwrap_or(0);
+        }
+        // The exact score sums the contributions in (form, word) order, as execution does.
+        let mut score = 0.0;
+        for (&tf, &idf) in hits.iter().zip(&idf_by_order) {
+            if tf > 0 {
+                let tf = f64::from(tf);
+                score += idf * tf * 2.2 / (tf + norm);
+            }
+        }
+        if score < threshold {
+            continue;
+        }
+        kept.push((score, slot));
+        if kept.len() >= 2 * limit {
+            kept.select_nth_unstable_by(limit - 1, compare);
+            kept.truncate(limit);
+            threshold = kept[limit - 1].0;
+            while essential < lists.len() && prefix[essential] < threshold {
+                essential += 1;
+            }
+        }
+    }
+    #[cfg(test)]
+    let t2 = std::time::Instant::now();
+    kept.sort_unstable_by(compare);
+    kept.truncate(limit);
+    #[cfg(test)]
+    {
+        use std::sync::atomic::Ordering::Relaxed;
+        RANKED_NS[0].fetch_add((t1 - t0).as_nanos() as u64, Relaxed);
+        RANKED_NS[1].fetch_add((t2 - t1).as_nanos() as u64, Relaxed);
+        RANKED_NS[2].fetch_add(kept.len() as u64, Relaxed);
+    }
+    let mut lexical_scores = Vec::with_capacity(kept.len());
+    let chunks = kept
+        .iter()
+        .map(|&(score, slot)| {
+            lexical_scores.push(score);
+            let (document, index) = store.owned_chunk(slot as usize);
+            CapturedChunk {
+                document,
+                index,
+                word_count: store.slot_word_count(slot as usize),
+                semantic_cache: None,
+            }
+        })
+        .collect();
+    CapturedQuery {
+        prepared,
+        chunks,
+        postings: Default::default(),
+        count: store.chunk_count,
+        words: store.word_count,
+        use_postings: false,
+        dense: None,
         dfs: Some(dfs),
+        lexical_scores: Some(lexical_scores),
         text: store.text_segment(),
     }
 }
