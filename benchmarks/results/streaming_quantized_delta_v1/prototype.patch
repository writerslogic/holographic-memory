+#[test]
+#[ignore = "development quantized delta recall and cost grid"]
+fn quantized_delta_grid() {
+    let base = std::env::var("HMS_DELTA_DATA").unwrap();
+    let query_path = std::env::var("HMS_DELTA_QUERIES").unwrap();
+    let n: usize = std::env::var("HMS_DELTA_ROWS")
+        .unwrap_or_else(|_| "1000000".into())
+        .parse()
+        .unwrap();
+    assert!((1000..=3_000_000).contains(&n));
+    let queries = read_rows(&query_path, 256, 128, 100);
+    let rows = read_rows(&base, 0, n, 100);
+    let params = BuildParams {
+        metric: Metric::Euclidean,
+        degree: 32,
+        build_ef: 64,
+        ..Default::default()
+    };
+    let mut delta = Delta::default();
+    let start = Instant::now();
+    delta.insert_batch(&(0..n as u32).collect::<Vec<_>>(), &rows, &params);
+    drop(rows);
+    println!("graph_build_ns={}", start.elapsed().as_nanos());
+    for deleted in [false, true] {
+        if deleted {
+            for id in (0..n as u32).step_by(5) {
+                delta.remove(id);
+            }
+        }
+        let truth = truth(&delta, &queries, 100);
+        for mode in [Mode::Int8, Mode::Rotated8, Mode::Binary] {
+            let mut codes = Codes::new(100, mode);
+            let start = Instant::now();
+            codes.append(&delta.vectors, 100);
+            println!(
+                "encode mode={mode:?} deleted={deleted} rows={n} ns={} code_bytes={}",
+                start.elapsed().as_nanos(),
+                codes.storage_bytes()
+            );
+            let widths = if matches!(mode, Mode::Binary) {
+                [512, 1024]
+            } else {
+                [256, 512]
+            };
+            for ef in widths {
+                for threads in [1, 8] {
+                    let pool = rayon::ThreadPoolBuilder::new()
+                        .num_threads(threads)
+                        .build()
+                        .unwrap();
+                    for (arm, active, width) in [
+                        ("base256", None, 256),
+                        ("base512", None, 512),
+                        ("candidate", Some(&codes), ef),
+                    ] {
+                        let found = pool.install(|| query_batch(&delta, active, &queries, width));
+                        println!("recall mode={mode:?} arm={arm} deleted={deleted} threads={threads} ef={ef} width={width} hits={} total=1280",recall(&found,&truth));
+                    }
+                    for pair in 0..3 {
+                        let arms = if pair == 1 {
+                            [true, false]
+                        } else {
+                            [false, true]
+                        };
+                        for candidate in arms {
+                            let active = candidate.then_some(&codes);
+                            let width = if candidate || !matches!(mode, Mode::Binary) {
+                                ef
+                            } else {
+                                ef / 2
+                            };
+                            std::hint::black_box(
+                                pool.install(|| query_batch(&delta, active, &queries, width)),
+                            );
+                            for repeat in 0..5 {
+                                let start = Instant::now();
+                                let found =
+                                    pool.install(|| query_batch(&delta, active, &queries, width));
+                                let elapsed = start.elapsed().as_nanos();
+                                std::hint::black_box(found);
+                                println!("timing mode={mode:?} deleted={deleted} threads={threads} ef={ef} pair={pair} candidate={candidate} repeat={repeat} ns={elapsed}");
+                            }
+                        }
+                    }
+                }
+            }
+        }
+    }
+}
