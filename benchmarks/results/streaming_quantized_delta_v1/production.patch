+#[test]
+#[ignore = "selected production delta configuration: tune verification or heldout"]
+fn quantized_delta_selected() {
+    let base = std::env::var("HMS_DELTA_DATA").unwrap();
+    let query_path = std::env::var("HMS_DELTA_QUERIES").unwrap();
+    let n: usize = std::env::var("HMS_DELTA_ROWS").unwrap().parse().unwrap();
+    let first: usize = std::env::var("HMS_DELTA_QUERY_FIRST")
+        .unwrap()
+        .parse()
+        .unwrap();
+    assert!(matches!(n, 1_000_000 | 3_000_000));
+    assert!(matches!(first, 256 | 384));
+    let queries = read_rows(&query_path, first, 128, 100);
+    let rows = read_rows(&base, 0, n, 100);
+    let params = BuildParams {
+        metric: Metric::Euclidean,
+        degree: 32,
+        build_ef: 64,
+        ..Default::default()
+    };
+    let mut delta = Delta::default();
+    let start = Instant::now();
+    delta.insert_batch(&(0..n as u32).collect::<Vec<_>>(), &rows, &params);
+    drop(rows);
+    println!("graph_build_ns={}", start.elapsed().as_nanos());
+    let start = Instant::now();
+    let mut codes = Some(super::codes::Codes::from_rows(&delta.vectors, 100).unwrap());
+    println!(
+        "encode mode=Production8 rows={n} ns={} code_bytes={}",
+        start.elapsed().as_nanos(),
+        codes.as_ref().unwrap().storage_bytes()
+    );
+    for deleted in [false, true] {
+        if deleted {
+            for id in (0..n as u32).step_by(5) {
+                delta.remove(id);
+            }
+        }
+        let truth = truth(&delta, &queries, 100);
+        if first == 256 {
+            let mut prototype = Codes::new(100, Mode::Int8);
+            prototype.append(&delta.vectors, 100);
+            queries.par_chunks(100).for_each(|query| {
+                let actual = codes
+                    .as_ref()
+                    .unwrap()
+                    .search::<false>(&delta, query, 256, Metric::Euclidean)
+                    .0;
+                let expected = prototype.search(&delta, query, 256);
+                let bits = |v: Vec<(f32, u32)>| {
+                    v.into_iter()
+                        .map(|(score, id)| (score.to_bits(), id))
+                        .collect::<Vec<_>>()
+                };
+                assert_eq!(bits(actual), bits(expected));
+            });
+            println!("prototype_bits_identical deleted={deleted} queries=128");
+        }
+        let mut checksums = [None, None];
+        for threads in [1, 8] {
+            let pool = rayon::ThreadPoolBuilder::new()
+                .num_threads(threads)
+                .build()
+                .unwrap();
+            for pair in 0..3 {
+                for candidate in if pair == 1 {
+                    [true, false]
+                } else {
+                    [false, true]
+                } {
+                    if candidate {
+                        delta.codes = codes.take();
+                    }
+                    let found = pool.install(|| query_batch(&delta, None, &queries, 256));
+                    let checksum =
+                        found
+                            .iter()
+                            .flatten()
+                            .fold(0xcbf29ce484222325u64, |h, &(score, id)| {
+                                (h ^ u64::from(score.to_bits()))
+                                    .wrapping_mul(0x100000001b3)
+                                    .wrapping_add(u64::from(id))
+                            });
+                    let previous = &mut checksums[usize::from(candidate)];
+                    assert!(previous.is_none_or(|v| v == checksum));
+                    *previous = Some(checksum);
+                    let arm = if candidate { "candidate" } else { "base256" };
+                    if pair == 0 {
+                        println!("recall mode=Production8 arm={arm} deleted={deleted} threads={threads} ef=256 width=256 hits={} total=1280 checksum={checksum:016x}", recall(&found, &truth));
+                    }
+                    std::hint::black_box(found);
+                    for repeat in 0..5 {
+                        let start = Instant::now();
+                        let found = pool.install(|| query_batch(&delta, None, &queries, 256));
+                        let elapsed = start.elapsed().as_nanos();
+                        std::hint::black_box(found);
+                        println!("timing mode=Production8 deleted={deleted} threads={threads} ef=256 pair={pair} candidate={candidate} repeat={repeat} ns={elapsed}");
+                    }
+                    if candidate {
+                        codes = delta.codes.take();
+                    }
+                }
+            }
+        }
+    }
+    if n == 1_000_000 {
+        let append = read_rows(&base, n, 100_000, 100);
+        let ids: Vec<_> = (n as u32..n as u32 + 100_000).collect();
+        let mut graph_checksum = None;
+        for pair in 0..3 {
+            for candidate in if pair == 1 {
+                [true, false]
+            } else {
+                [false, true]
+            } {
+                let mut updated = delta.clone();
+                updated.vectors = super::super::delta_rows::DeltaRows::default();
+                updated.vectors.extend_from_slice(&delta.vectors);
+                if candidate {
+                    updated.codes = codes.clone();
+                }
+                let start = Instant::now();
+                updated.reserve_codes(ids.len()).unwrap();
+                updated.insert_batch(&ids, &append, &params);
+                let elapsed = start.elapsed().as_nanos();
+                let checksum = (0..updated.len())
+                    .flat_map(|slot| updated.edges[slot].iter().copied())
+                    .fold(0xcbf29ce484222325u64, |h, id| {
+                        (h ^ u64::from(id)).wrapping_mul(0x100000001b3)
+                    });
+                assert!(graph_checksum.is_none_or(|v| v == checksum));
+                graph_checksum = Some(checksum);
+                println!("append pair={pair} candidate={candidate} rows=100000 ns={elapsed} code_bytes={} graph_checksum={checksum:016x}", updated.codes.as_ref().map_or(0, super::codes::Codes::storage_bytes));
+            }
+        }
+    }
+}
