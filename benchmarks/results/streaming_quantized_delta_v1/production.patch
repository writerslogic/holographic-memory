+#[test]
+fn compact_codes_append_and_rerank_original_rows() {
+    for dim in [1, 15, 16, 17, 31, 32, 33, 100, 128, 129] {
+        let mut random = crate::core::qgraph::kernels::SplitMix(42);
+        let mut rows: Vec<_> = (0..9 * dim).map(|_| random.next_f32() - 0.5).collect();
+        rows[..dim].fill(-0.0);
+        let params = BuildParams {
+            metric: Metric::Euclidean,
+            degree: 8,
+            build_ef: 16,
+            ..Default::default()
+        };
+        let mut delta = Delta::default();
+        delta.insert_batch(&(0..9).rev().collect::<Vec<_>>(), &rows, &params);
+        delta.remove(0);
+        delta.insert(2, &rows[..dim], &params);
+        for mode in [Mode::Int8, Mode::Rotated8, Mode::Binary] {
+            let mut split = Codes::new(dim, mode);
+            split.append(&delta.vectors[..4 * dim], dim);
+            split.append(&delta.vectors[4 * dim..], dim);
+            let mut whole = Codes::new(dim, mode);
+            whole.append(&delta.vectors, dim);
+            assert_eq!(split.bytes, whole.bytes);
+            assert_eq!(split.bits, whole.bits);
+            assert_eq!(split.scales, whole.scales);
+            assert_eq!(split.pops, whole.pops);
+            for query in rows.chunks_exact(dim).take(3) {
+                let actual = split.search(&delta, query, delta.len());
+                let expected = delta.search(query, delta.len(), Metric::Euclidean);
+                let bits = |v: Vec<(f32, u32)>| {
+                    v.into_iter()
+                        .map(|(d, id)| (d.to_bits(), id))
+                        .collect::<Vec<_>>()
+                };
+                assert_eq!(bits(actual), bits(expected), "{mode:?}, dim={dim}");
+                if matches!(mode, Mode::Int8) {
+                    let production = super::codes::Codes::from_rows(&delta.vectors, dim).unwrap();
+                    for ef in [0, 1, 2, delta.len() - 1, delta.len(), delta.len() + 1] {
+                        let (actual, visits) =
+                            production.search::<true>(&delta, query, ef, Metric::Euclidean);
+                        assert_eq!(bits(actual), bits(split.search(&delta, query, ef)));
+                        assert!((1..=delta.len()).contains(&visits));
+                    }
+                }
+            }
+        }
+    }
+}
