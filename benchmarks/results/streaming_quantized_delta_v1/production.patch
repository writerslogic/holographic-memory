+fn read_rows(path: &str, first: usize, count: usize, dim: usize) -> Vec<f32> {
+    let mut file = std::fs::File::open(path).unwrap();
+    let mut header = [0; 8];
+    file.read_exact(&mut header).unwrap();
+    assert_eq!(
+        u32::from_le_bytes(header[4..].try_into().unwrap()) as usize,
+        dim
+    );
+    assert!(u32::from_le_bytes(header[..4].try_into().unwrap()) as usize >= first + count);
+    file.seek(SeekFrom::Start((8 + first * dim * 4) as u64))
+        .unwrap();
+    let mut bytes = vec![0; count * dim * 4];
+    file.read_exact(&mut bytes).unwrap();
+    bytes
+        .as_chunks::<4>()
+        .0
+        .iter()
+        .map(|b| f32::from_le_bytes(*b))
+        .collect()
+}
+
+fn truth(delta: &Delta, queries: &[f32], dim: usize) -> Vec<Vec<u32>> {
+    queries
+        .par_chunks(dim)
+        .map(|q| {
+            let mut scored: Vec<_> = (0..delta.len())
+                .filter(|&u| delta.alive[u])
+                .map(|u| (delta.score(q, u, Metric::Euclidean), delta.ids[u]))
+                .collect();
+            scored.select_nth_unstable_by(9, |a, b| a.0.total_cmp(&b.0).then(a.1.cmp(&b.1)));
+            scored.truncate(10);
+            scored.iter().map(|(_, id)| *id).collect()
+        })
+        .collect()
+}
+
+fn query_batch(
+    delta: &Delta,
+    codes: Option<&Codes>,
+    queries: &[f32],
+    ef: usize,
+) -> Vec<Vec<(f32, u32)>> {
+    queries
+        .par_chunks(100)
+        .map(|q| {
+            codes.map_or_else(
+                || delta.search(q, ef, Metric::Euclidean),
+                |codes| codes.search(delta, q, ef),
+            )
+        })
+        .collect()
+}
+
+fn recall(found: &[Vec<(f32, u32)>], truth: &[Vec<u32>]) -> usize {
+    found
+        .iter()
+        .zip(truth)
+        .map(|(hits, gt)| hits.iter().take(10).filter(|h| gt.contains(&h.1)).count())
+        .sum()
+}
