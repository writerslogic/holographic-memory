+            .search(&rows[..17], 10, search_params())
+            .unwrap()
+            .is_empty());
+        index
+            .insert_batch(&(0..128).collect::<Vec<_>>(), &rows[..128 * 17])
+            .unwrap();
+        index.commit().unwrap();
+        index.set_delta_quantized(false).unwrap();
+        let original = index.search(&rows[..17], 10, search_params()).unwrap();
+        index.set_delta_quantized(true).unwrap();
+        assert_eq!(
+            index.search(&rows[..17], 10, search_params()).unwrap(),
+            original
+        );
+        index
+            .insert_batch(&(128..192).collect::<Vec<_>>(), &rows[128 * 17..])
+            .unwrap();
+        index.commit().unwrap();
+        index.replace(0, &rows[17..34]).unwrap();
+        index.commit().unwrap();
+        index.replace_batch(&[2, 3], &rows[68..102]).unwrap();
+        index.commit().unwrap();
+        index.delete_batch(&[1, 4, 5]).unwrap();
+        index.commit().unwrap();
+        let before = index.len();
+        assert!(matches!(
+            index.replace_batch(&[2, 9999], &rows[..34]),
+            Err(UpdateError::UnknownId(9999))
+        ));
+        assert_eq!(index.len(), before);
+        assert!(index
+            .consolidate_inner(|step| if step == 1 {
+                Err(std::io::Error::other("injected before publication").into())
+            } else {
+                Ok(())
+            })
+            .is_err());
+        {
+            let state = index.state.read();
+            let delta = &state.delta;
+            let fresh = delta::codes::Codes::from_rows(&delta.vectors, 17).unwrap();
+            for ef in [1, 2, 16, delta.len() - 1] {
