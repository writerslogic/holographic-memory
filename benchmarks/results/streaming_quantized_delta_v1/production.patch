diff --git a/src/core/qgraph/update/delta_codes.rs b/src/core/qgraph/update/delta_codes.rs
new file mode 100644
index 00000000..8cc678f0
--- /dev/null
+++ b/src/core/qgraph/update/delta_codes.rs
@@ -0,0 +1,254 @@
+// Copyright 2024-2026 WritersLogic Contributors
+// SPDX-License-Identifier: Apache-2.0
+
+use super::*;
+use crate::core::qgraph::{kernels, vertex::quantize, vnni};
+use rayon::prelude::*;
+
+const MAX_WIDTH: usize = 65536;
+
+#[derive(Clone)]
+pub(in crate::core::qgraph::update) struct Codes {
+    dim: usize,
+    width: usize,
+    bytes: Vec<i8>,
+    scales: Vec<f32>,
+}
+
+impl Codes {
+    #[cfg(test)]
+    pub(in crate::core::qgraph::update) fn storage_bytes(&self) -> usize {
+        self.bytes.capacity() + self.scales.capacity() * 4
+    }
+
+    pub(in crate::core::qgraph::update) fn from_rows(
+        rows: &[f32],
+        dim: usize,
+    ) -> Result<Self, super::super::UpdateError> {
+        // The unsigned VNNI intermediate is bounded by width * 255 * 127.
+        if dim == 0 || dim > MAX_WIDTH {
+            return Err(super::super::UpdateError::InvalidVector(
+                "quantized delta search requires a dimension from 1 through 65536",
+            ));
+        }
+        let mut codes = Self {
+            dim,
+            width: dim.next_multiple_of(16),
+            bytes: Vec::new(),
+            scales: Vec::new(),
+        };
+        codes.reserve(rows.len() / dim)?;
+        codes.append_reserved(rows);
+        Ok(codes)
+    }
+
+    pub(in crate::core::qgraph::update) fn empty_like(&self) -> Self {
+        Self {
+            dim: self.dim,
+            width: self.width,
+            bytes: Vec::new(),
+            scales: Vec::new(),
+        }
+    }
+
+    pub(super) fn reserve(&mut self, additional: usize) -> Result<(), super::super::UpdateError> {
+        let capacity = || super::super::UpdateError::Capacity;
+        let needed = self
+            .scales
+            .len()
+            .checked_add(additional)
+            .ok_or_else(capacity)?;
+        if needed <= self.scales.capacity() && needed <= self.bytes.capacity() / self.width {
+            return Ok(());
+        }
+        let grown = self
+            .scales
+            .capacity()
+            .checked_add(self.scales.capacity() / 8)
+            .ok_or_else(capacity)?;
+        let slots = needed.max(grown);
+        let bytes = slots.checked_mul(self.width).ok_or_else(capacity)?;
+        self.bytes
+            .try_reserve_exact(bytes - self.bytes.len())
+            .map_err(|_| capacity())?;
+        self.scales
+            .try_reserve_exact(slots - self.scales.len())
+            .map_err(|_| capacity())?;
+        Ok(())
+    }
+
+    pub(super) fn append_reserved(&mut self, rows: &[f32]) {
+        let first = self.scales.len();
+        let count = rows.len() / self.dim;
+        assert_eq!(rows.len() % self.dim, 0);
+        assert!(self.scales.capacity() >= first + count);
+        assert!(self.bytes.capacity() >= (first + count) * self.width);
+        self.scales.resize(first + count, 0.0);
+        self.bytes.resize((first + count) * self.width, 0);
+        let bytes = &mut self.bytes[first * self.width..];
+        let scales = &mut self.scales[first..];
+        if count < 64 {
+            for ((code, scale), row) in bytes
+                .chunks_mut(self.width)
+                .zip(scales)
+                .zip(rows.chunks(self.dim))
+            {
+                *scale = quantize(row, code);
+            }
+        } else {
+            bytes
+                .par_chunks_mut(self.width)
+                .zip(scales.par_iter_mut())
+                .zip(rows.par_chunks(self.dim))
+                .for_each(|((code, scale), row)| *scale = quantize(row, code));
+        }
+    }
+
+    pub(in crate::core::qgraph::update) fn search<const PROFILE: bool>(
+        &self,
+        delta: &Delta,
+        query: &[f32],
+        ef: usize,
+        metric: Metric,
+    ) -> (Vec<(f32, u32)>, usize) {
+        let mut query_code = vec![0; self.width];
+        let scale = quantize(query, &mut query_code);
+        let sum = vnni::query_sum(&query_code);
+        let code = |u: usize| &self.bytes[u * self.width..(u + 1) * self.width];
+        let estimate = |u: usize, raw: i32| {
+            let dot = scale * self.scales[u] * raw as f32;
+            let score = match metric {
+                Metric::Angular => -dot,
+                Metric::Euclidean => delta.norms[u] * 0.5 - dot,
+            };
+            if score.is_finite() {
+                score
+            } else {
+                delta.score(query, u, metric)
+            }
+        };
+        SEEN.with(|seen| {
+            let mut seen = seen.borrow_mut();
+            seen.reset(delta.len());
+            seen.insert(0);
+            let mut pool = vec![(
+                estimate(0, kernels::dot_i8_query(&query_code, code(0), sum)),
+                0usize,
+                false,
+            )];
+            let mut fresh = std::mem::take(&mut seen.fresh);
+            let mut scores = std::mem::take(&mut seen.dists);
+            let mut visits = usize::from(PROFILE);
+            let mut cur = 0;
+            loop {
+                while cur < pool.len() && pool[cur].2 {
+                    cur += 1;
+                }
+                if cur == pool.len() {
+                    break;
+                }
+                pool[cur].2 = true;
+                let slot = pool[cur].1;
+                fresh.clear();
+                let mut add = |u: u32| {
+                    if seen.insert(u) {
+                        let slot = u as usize;
+                        kernels::prefetch_bytes(code(slot));
+                        crate::core::qgraph::build_kernels::prefetch_meta(&self.scales[slot]);
+                        if metric == Metric::Euclidean {
+                            crate::core::qgraph::build_kernels::prefetch_meta(&delta.norms[slot]);
+                        }
+                        fresh.push(u);
+                    }
+                };
+                for &u in &delta.edges[slot] {
+                    add(u);
+                }
+                let mut child = delta.first_child[slot];
+                while child != NONE {
+                    add(child);
+                    child = delta.next_sibling[child as usize];
+                }
+                if PROFILE {
+                    visits += fresh.len();
+                }
+                scores.clear();
+                let (quads, tail) = fresh.as_chunks::<4>();
+                for &quad in quads {
+                    let raw =
+                        kernels::dot_i8_query_x4(&query_code, quad.map(|u| code(u as usize)), sum);
+                    scores.extend((0..4).map(|i| estimate(quad[i] as usize, raw[i])));
+                }
+                scores.extend(tail.iter().map(|&u| {
+                    estimate(
+                        u as usize,
+                        kernels::dot_i8_query(&query_code, code(u as usize), sum),
+                    )
+                }));
+                for (&u, &d) in fresh.iter().zip(&scores) {
+                    let u = u as usize;
+                    if pool.len() == ef {
+                        let worst = pool.last().unwrap();
+                        if worst.0.total_cmp(&d).then(worst.1.cmp(&u)).is_lt() {
+                            continue;
+                        }
+                    }
+                    let at = pool.partition_point(|p| p.0.total_cmp(&d).then(p.1.cmp(&u)).is_lt());
+                    if at < ef {
+                        pool.insert(at, (d, u, false));
+                        pool.truncate(ef);
+                        cur = cur.min(at);
+                    }
+                }
+            }
+            seen.fresh = fresh;
+            seen.dists = scores;
+            let vectors: &[f32] = &delta.vectors;
+            for &(_, slot, _) in &pool {
+                if delta.alive[slot] {
+                    prefetch_row(&vectors[slot * query.len()..(slot + 1) * query.len()]);
+                }
+            }
+            let mut found: Vec<_> = pool
+                .into_iter()
+                .filter(|(_, slot, _)| delta.alive[*slot])
+                .map(|(_, slot, _)| {
+                    (
+                        delta.score_from(vectors, query, slot, metric),
+                        delta.ids[slot],
+                    )
+                })
+                .collect();
+            found.sort_unstable_by(|a, b| a.0.total_cmp(&b.0).then(a.1.cmp(&b.1)));
+            (found, visits)
+        })
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn integer_width_and_allocation_boundaries() {
+        for dim in [MAX_WIDTH - 1, MAX_WIDTH] {
+            let codes = Codes::from_rows(&vec![1.0; dim], dim).unwrap();
+            let q = vec![127; codes.width];
+            let expected = (dim as i32) * 127 * 127;
+            assert_eq!(
+                kernels::dot_i8_query(&q, &codes.bytes, vnni::query_sum(&q)),
+                expected
+            );
+            let mut codes = codes;
+            let before = codes.bytes.clone();
+            assert!(matches!(
+                codes.reserve(usize::MAX),
+                Err(super::super::super::UpdateError::Capacity)
+            ));
+            assert_eq!(codes.bytes, before);
+        }
+        for dim in [0, MAX_WIDTH + 1, usize::MAX] {
+            assert!(Codes::from_rows(&[], dim).is_err());
+        }
+    }
+}
