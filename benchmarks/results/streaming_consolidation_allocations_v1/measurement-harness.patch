@@ -0,0 +1,84 @@
+// Copyright 2024-2026 WritersLogic Contributors
+// SPDX-License-Identifier: Apache-2.0
+//! Measures one consolidation with the ordinary allocator and no construction hooks.
+//! Run a copied, committed streaming fixture inside its own Linux memory cgroup.
+
+use std::fs::{File, OpenOptions};
+use std::io::{Read, Seek, Write};
+use std::path::{Path, PathBuf};
+use std::time::Instant;
+
+use holographic_memory::core::qgraph::{ConsolidationMode, UpdatableVGraph};
+use serde_json::json;
+
+fn value(path: &Path, key: Option<&str>) -> Result<u64, Box<dyn std::error::Error>> {
+    let text = std::fs::read_to_string(path)?;
+    let value = match key {
+        Some(key) => text
+            .lines()
+            .find_map(|line| line.strip_prefix(key))
+            .ok_or("missing process statistic")?,
+        None => &text,
+    };
+    Ok(value
+        .split_whitespace()
+        .next()
+        .ok_or("empty process statistic")?
+        .parse()?)
+}
+
+fn read_peak(file: &mut File) -> Result<u64, Box<dyn std::error::Error>> {
+    file.rewind()?;
+    let mut value = String::new();
+    file.read_to_string(&mut value)?;
+    Ok(value.trim().parse()?)
+}
+
+fn main() -> Result<(), Box<dyn std::error::Error>> {
+    let mut args = std::env::args_os().skip(1);
+    let path = PathBuf::from(args.next().ok_or("fixture directory is required")?);
+    if args.next().is_some() {
+        return Err("expected only one fixture directory".into());
+    }
+    let groups = std::fs::read_to_string("/proc/self/cgroup")?;
+    let group = groups
+        .lines()
+        .find_map(|line| line.strip_prefix("0::"))
+        .ok_or("unified cgroup is required")?;
+    let cgroup = Path::new("/sys/fs/cgroup").join(group.trim_start_matches('/'));
+    let index = UpdatableVGraph::open(&path)?;
+    let status = Path::new("/proc/self/status");
+    let io = Path::new("/proc/self/io");
+    let before_rss = value(status, Some("VmRSS:"))?;
+    let before_bytes = value(io, Some("write_bytes:"))?;
+    let before_memory = value(&cgroup.join("memory.current"), None)?;
+    std::fs::write("/proc/self/clear_refs", b"5")?;
+    // Linux resets memory.peak for this open file description, not for later opens.
+    let mut peak = OpenOptions::new()
+        .read(true)
+        .write(true)
+        .open(cgroup.join("memory.peak"))?;
+    peak.write_all(b"0")?;
+    let start = Instant::now();
+    let how = index.consolidate_with(ConsolidationMode::Merge {
+        rebuild_after: 10.0,
+    })?;
+    let elapsed_ns = start.elapsed().as_nanos();
+    println!(
+        "{}",
+        json!({
+            "mode": format!("{how:?}"), "live": index.len(), "elapsed_ns": elapsed_ns,
+            "threads": rayon::current_num_threads(),
+            "rss_before_kib": before_rss,
+            "rss_after_kib": value(status, Some("VmRSS:"))?,
+            "isolated_peak_rss_kib": value(status, Some("VmHWM:"))?,
+            "written_bytes": value(io, Some("write_bytes:"))? - before_bytes,
+            "cgroup_before": before_memory,
+            "cgroup_after": value(&cgroup.join("memory.current"), None)?,
+            "isolated_cgroup_peak": read_peak(&mut peak)?,
+            "lifetime_cgroup_peak": value(&cgroup.join("memory.peak"), None)?,
+            "load": std::fs::read_to_string("/proc/loadavg")?.trim(),
+        })
+    );
+    Ok(())
+}
