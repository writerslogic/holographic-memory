+
+fn prepare_streaming(
+    path: &Path,
+    data: &[f32],
+    dim: usize,
+    params: &BuildParams,
+) -> Result<(), Box<dyn std::error::Error>> {
+    if dim == 0 || !data.len().is_multiple_of(dim) {
+        return Err("invalid row geometry".into());
+    }
+    let total = data.len() / dim;
+    if !(120..u32::MAX as usize).contains(&total) {
+        return Err("streaming fixture requires 120..u32::MAX rows".into());
+    }
+    let base = total / 6 * 5;
+    let index = UpdatableVGraph::create(path, &data[..base * dim], dim, params)?;
+    let capacity = index.batch_capacity();
+    let doomed: Vec<u32> = (0..base as u32).filter(|id| id % 7 == 0).collect();
+    for ids in doomed.chunks(capacity) {
+        index.delete_batch(ids)?;
+        index.commit()?;
+    }
+    for first in (base..total).step_by(capacity) {
+        let end = total.min(first + capacity);
+        let ids: Vec<u32> = (first as u32..end as u32).collect();
+        index.insert_batch(&ids, &data[first * dim..end * dim])?;
+        index.commit()?;
+    }
+    println!(
+        "prepared base={base} inserted={} deleted={} live={}",
+        total - base,
+        doomed.len(),
+        index.len()
+    );
+    Ok(())
+}
+
+fn profile_consolidation(path: &Path) -> Result<(), Box<dyn std::error::Error>> {
+    #[cfg(target_os = "linux")]
+    {
+        let groups = std::fs::read_to_string("/proc/self/cgroup")?;
+        let group = groups
+            .lines()
+            .find_map(|line| line.strip_prefix("0::"))
+            .ok_or("unified cgroup is required for memory attribution")?;
+        CGROUP
+            .set(Path::new("/sys/fs/cgroup").join(group.trim_start_matches('/')))
+            .map_err(|_| "cgroup already initialized")?;
+    }
+    if !set_build_phase_hook(end_stream_phase) {
+        return Err("build phase hook already installed".into());
+    }
+    end_stream_phase("begin");
+    let index = UpdatableVGraph::open(path)?;
+    end_stream_phase("opened");
+    #[cfg(target_os = "linux")]
+    std::fs::write("/proc/self/clear_refs", b"5")?;
+    end_stream_phase("consolidation-start");
+    let start = Instant::now();
+    let how = index.consolidate_with(ConsolidationMode::Merge {
+        rebuild_after: 10.0,
+    })?;
+    let elapsed = start.elapsed().as_secs_f64();
+    end_stream_phase("published");
+    println!(
+        "consolidated mode={how:?} live={} elapsed={elapsed:.6}",
+        index.len()
+    );
+    let mut vertices = Vec::new();
+    for entry in std::fs::read_dir(path)? {
+        let entry = entry?;
+        let name = entry.file_name();
+        let name = name.to_string_lossy();
+        if name.starts_with("base-") && name.ends_with(".vertex") {
+            vertices.push(entry.path());
+        }
+    }
+    if vertices.len() != 1 {
+        return Err("expected one published vertex file".into());
+    }
+    let mut file = std::fs::File::open(&vertices[0])?;
+    let mut buffer = [0u8; 65536];
+    let mut checksum = crc32fast::Hasher::new();
+    loop {
+        let read = file.read(&mut buffer)?;
+        if read == 0 {
+            break;
+        }
+        checksum.update(&buffer[..read]);
+    }
+    println!("vertex_crc32 {}", checksum.finalize());
+    Ok(())
+}
