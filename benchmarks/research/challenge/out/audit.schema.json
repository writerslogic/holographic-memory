{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "warm-research-challenge/audit/v1",
  "title": "warm-research-challenge trace audit",
  "description": "Written by `warm-research-challenge audit --out FILE`. Fraction of agent queries that carry a usable (entity, attribute) key through caller metadata or the template rules.",
  "type": "object",
  "required": ["schema", "trace", "synthetic", "queries", "malformed_lines", "keyed_by_metadata", "keyed_by_rule", "unkeyed", "usable_fraction", "threshold", "pass", "by_rule", "samples_keyed_by_rule", "samples_unkeyed", "note"],
  "properties": {
    "schema": { "const": "warm-research-challenge/audit/v1" },
    "trace": { "type": "string", "description": "Path of the JSONL trace audited." },
    "synthetic": { "type": "boolean", "description": "true: the trace was generated by this crate and the fraction is not evidence about any agent." },
    "queries": { "type": "integer" },
    "malformed_lines": { "type": "integer", "description": "Non-empty lines that were not a JSON object with a non-empty text." },
    "keyed_by_metadata": { "type": "integer", "description": "Both entity_id and attribute_key present and well formed." },
    "keyed_by_rule": { "type": "integer" },
    "unkeyed": { "type": "integer" },
    "usable_fraction": { "type": "number", "minimum": 0, "maximum": 1 },
    "threshold": { "const": 0.5 },
    "pass": { "type": "boolean", "description": "queries > 0 and usable_fraction >= threshold." },
    "by_rule": {
      "type": "object",
      "additionalProperties": { "type": "integer" },
      "description": "Keys: kv, possessive, attribute-of-entity, attribute-for-entity, entity-colon-attribute, identifier-then-attribute."
    },
    "samples_keyed_by_rule": { "type": "array", "items": { "$ref": "#/$defs/sample" } },
    "samples_unkeyed": { "type": "array", "items": { "$ref": "#/$defs/sample" } },
    "note": { "type": "string" }
  },
  "$defs": {
    "sample": {
      "type": "object",
      "required": ["text", "key"],
      "properties": {
        "text": { "type": "string" },
        "key": {
          "type": ["object", "null"],
          "required": ["entity", "attribute", "source"],
          "properties": {
            "entity": { "type": "string" },
            "attribute": { "type": "string" },
            "source": { "enum": ["metadata", "rule"] },
            "rule": { "type": "string" }
          }
        }
      }
    }
  }
}
