{
  "name": "@writerslogic/warm-langchain",
  "version": "0.1.0",
  "description": "LangChain.js VectorStore, retriever and chat message history backed by WARM",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
      "require": { "types": "./dist/index.d.cts", "default": "./dist/index.cjs" }
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "tsup && node --test test/*.test.mjs"
  },
  "dependencies": {
    "@writerslogic/warm-core": "^0.1.0"
  },
  "peerDependencies": {
    "@langchain/core": ">=1.2.19 <2"
  },
  "devDependencies": {
    "@langchain/core": "1.2.19"
  }
}
