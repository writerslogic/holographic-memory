    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "test": "tsup && node --test test/*.test.mjs"
  },
  "dependencies": {
    "@holographic-memory/core": "^0.1.0"
  },
  "peerDependencies": {
    "@mastra/core": ">=1.78.0 <2"
  },
  "devDependencies": {
    "@mastra/core": "1.78.0",
    "@mastra/libsql": "1.26.2",
    "@mastra/memory": "1.38.0",
    "zod": "^4.1.8"
  }
}
