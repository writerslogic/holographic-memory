{
  "name": "@holographic-memory/mastra",
  "version": "0.1.0",
  "description": "Mastra vector store backed by Holographic Memory",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
