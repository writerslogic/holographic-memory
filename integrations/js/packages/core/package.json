{
  "name": "@holographic-memory/core",
  "version": "0.1.0",
  "description": "Memory API (remember, recall, get, list, forget) over the Holographic Memory native engine, shared by the framework adapters",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
      "require": { "types": "./dist/index.d.cts", "default": "./dist/index.cjs" }
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "test": "tsup && node --test test/*.test.mjs"
  },
  "peerDependencies": {
    "holographic-memory": ">=0.6.0"
  }
}
